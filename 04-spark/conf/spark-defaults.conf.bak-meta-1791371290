#
# Spark 全局默认配置 — [tuned 2026-10-07]
# 环境：单节点伪分布式 / 4 vCPU / 13.9GB 内存 / Hadoop 3.3.6 / YARN
# 运行模式：Spark on YARN（集群已有 YARN，不再用 standalone）
# 内存账本：YARN NM 池 8192MB；预留 1024 给 driver/AM，余 7168 给 executor
#           → 2 个 executor × 3072MB（含 384MB overhead + 2688 堆）
#

# ===== 运行模式 =====
spark.master                          yarn
spark.submit.deployMode               client
spark.yarn.queue                      default

# ===== Driver =====
spark.driver.memory                   1536m
spark.driver.cores                    1
spark.driver.maxResultSize            512m

# ===== Executor =====
spark.executor.instances              2
spark.executor.cores                  2
spark.executor.memory                 2688m
spark.executor.memoryOverhead         384m
spark.yarn.am.memory                  1024m
spark.yarn.am.cores                   1

# ===== 动态分配：小集群关闭（避免反复申请释放拖慢）=====
spark.dynamicAllocation.enabled       false

# ===== 序列化：Kryo（比 Java 序列化快 2-5 倍，体积小 10x）=====
spark.serializer                      org.apache.spark.serializer.KryoSerializer
spark.kryoserializer.buffer.max       256m
spark.kryoserializer.buffer           64m

# ===== AQE 自适应查询执行（Spark 3.x 最大性能红利）=====
spark.sql.adaptive.enabled            true
spark.sql.adaptive.coalescePartitions.enabled        true
spark.sql.adaptive.advisoryPartitionSizeInBytes      128m
spark.sql.adaptive.coalescePartitions.minPartitionNum 1
spark.sql.adaptive.skewJoin.enabled   true
spark.sql.adaptive.localShuffleReader.enabled        true

# ===== Shuffle =====
spark.sql.shuffle.partitions          8
spark.shuffle.compress                true
spark.shuffle.spill.compress          true
spark.shuffle.file.buffer             128k
spark.reducer.maxSizeInFlight         96m
spark.shuffle.io.maxRetries           5
spark.shuffle.io.retryWait            5s

# ===== 分区/IO =====
spark.sql.files.maxPartitionBytes     134217728
spark.sql.files.openCostInBytes       4194304
spark.sql.parquet.compression.codec   snappy
spark.sql.orc.compression.codec       snappy
spark.sql.parquet.filterPushdown      true
spark.sql.orc.filterPushdown          true
spark.sql.parquet.mergeSchema         false

# ===== CBO / 统计信息 =====
spark.sql.cbo.enabled                 true
spark.sql.cbo.joinReorder.enabled     true
spark.sql.statistics.fallBackToHdfs   true

# ===== Hive 集成 =====
spark.sql.warehouse.dir               /hive3/warehouse
spark.sql.hive.metastore.version      3.1.3
spark.sql.hive.metastore.jars         builtin
spark.sql.hive.convertMetastoreParquet true
spark.sql.hive.convertMetastoreOrc     true

# ===== GC（G1，低延迟）=====
spark.executor.extraJavaOptions       -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError
spark.driver.extraJavaOptions         -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ===== 日志 =====
spark.eventLog.enabled                true
spark.eventLog.dir                    hdfs://192.168.42.101:8020/spark-logs
spark.history.fs.logDirectory         hdfs://192.168.42.101:8020/spark-logs
spark.ui.showConsoleProgress          false
spark.ui.port                         4040
