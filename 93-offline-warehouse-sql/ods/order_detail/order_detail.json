{
  "job": {
    "setting": {
      "speed": {
        "channel": 1
      }
    },
    "content": [
      {
        "reader": {
          "name": "mysqlreader",
          "parameter": {
            "username": "bigdata",
            "password": "bigdata",
            "connection": [
              {
                "querySql": [
                  "SELECT * FROM order_detail WHERE date(create_time)='${dt}' "
                ],
                "jdbcUrl": [
                  "jdbc:mysql://192.168.110.131:3306/cloud_ecommerce?useUnicode=true&characterEncoding=utf-8"
                ]
              }
            ]
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "defaultFS": "hdfs://192.168.42.101:8020",
            "fileType": "text",
            "path": "/hive3/warehouse/ods.db/ods_order_detail/dt=${dt}",
            "fileName": "order_detail",
            "column": [
              { "name": "detail_id",        "type": "BIGINT" },
              { "name": "order_id",         "type": "BIGINT" },
              { "name": "product_id",       "type": "BIGINT" },
              { "name": "product_price",    "type": "STRING" },
              { "name": "product_quantity", "type": "INT"    },
              { "name": "total_amount",     "type": "STRING" },
              { "name": "create_time",      "type": "STRING" }
            ],
            "writeMode": "truncate",
            "fieldDelimiter": "\t"
          }
        }
      }
    ]
  }
}
