{
  "job": {
    "setting": {
      "speed": {
        "channel": 1
      }
    },
    "content": [
      {
        "reader": {
          "name": "mysqlreader",
          "parameter": {
            "username": "bigdata",
            "password": "bigdata",
            "connection": [
              {
                "querySql": [
                  "SELECT * FROM product_info "
                ],
                "jdbcUrl": [
                  "jdbc:mysql://192.168.110.131:3306/cloud_ecommerce?useUnicode=true&characterEncoding=utf-8"
                ]
              }
            ]
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "defaultFS": "hdfs://192.168.42.101:8020",
            "fileType": "text",
            "path": "/hive3/warehouse/ods.db/ods_product_info",
            "fileName": "product_info",
            "column": [
              { "name": "product_id",     "type": "BIGINT" },
              { "name": "product_name",   "type": "STRING" },
              { "name": "category_id",    "type": "INT"    },
              { "name": "brand_id",       "type": "INT"    },
              { "name": "product_price",  "type": "STRING" },
              { "name": "market_price",   "type": "STRING" },
              { "name": "cost_price",     "type": "STRING" },
              { "name": "stock",          "type": "INT"    },
              { "name": "sales",          "type": "INT"    },
              { "name": "product_weight", "type": "STRING" },
              { "name": "product_desc",   "type": "STRING" },
              { "name": "main_image",     "type": "STRING" },
              { "name": "status",         "type": "TINYINT" },
              { "name": "create_time",    "type": "STRING" },
              { "name": "update_time",    "type": "STRING" }
            ],
            "writeMode": "truncate",
            "fieldDelimiter": "\t"
          }
        }
      }
    ]
  }
}
