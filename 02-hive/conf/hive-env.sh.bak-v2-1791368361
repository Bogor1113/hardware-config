export HADOOP_HOME=/opt/hadoop3
export HADOOP_CONF_DIR=$HADOOP_HOME/etc/hadoop
export HADOOP_OPTS="$HADOOP_OPTS -Dhive.log.level=ERROR -Dorg.slf4j.simpleLogger.defaultLogLevel=error"
export TEZ_HOME=/opt/tez-0.10.2
export TEZ_CONF_DIR=$TEZ_HOME/conf
# 只收集 tez 自身 jar（tez-*.jar），排除 tez 自带的 hadoop-* 避免与集群 hadoop 3.3.6 冲突
export TEZ_JARS=$(ls $TEZ_HOME/tez-*.jar | tr '\n' ':' | sed 's/:$//')
export HIVE_AUX_JARS_PATH=$TEZ_JARS
export HADOOP_CLIENT_OPTS="$HADOOP_CLIENT_OPTS -Dlog4j.configuration=file:/opt/hive3/conf/client-log4j.properties"

# ============================================================
# [tuned 2026-10-07] 堆口径拆分（v2 - 按 Hive 3.1.3 脚本实际识别的变量名）
#
# 取证过程：
#   bin/ext/hiveserver2.sh → export HADOOP_OPTS="$HIVESERVER2_HADOOP_OPTS ..."
#   bin/ext/metastore.sh   → export HADOOP_OPTS="$HIVE_METASTORE_HADOOP_OPTS ..."
#   bin/hive-config.sh:70  → export HADOOP_HEAPSIZE=${HADOOP_HEAPSIZE:-256}
#   Hadoop 的 hadoop-config.sh 把 HADOOP_HEAPSIZE 翻成 -Xmx 追加到 HADOOP_CLIENT_OPTS 末尾。
#
# 原状问题：HADOOP_HEAPSIZE=1024 同时管住 HS2 / Metastore / CLI 三者，
#           HS2 堆只有 1024m 却已用 89%，随时 OOM。
# 现方案：
#   - 服务端角色用各自专属变量显式指定，避免互相牵制
#   - HADOOP_HEAPSIZE 归零，只让 CLI/beeline 用 HADOOP_CLIENT_OPTS 里的 1024m
# ============================================================
unset HADOOP_HEAPSIZE
export HADOOP_CLIENT_OPTS="$HADOOP_CLIENT_OPTS -Xmx1024m"   # 客户端(CLI/beeline) 1024m 够用

export HIVESERVER2_HADOOP_OPTS="-Xmx1536m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError"
export HIVE_METASTORE_HADOOP_OPTS="-Xmx1024m -XX:+UseG1GC -XX:+HeapDumpOnOutOfMemoryError"
